# Supabase — copie este arquivo para `.env.local` e preencha os dois valores.
#
# Onde achar: Dashboard do Supabase > Project Settings > API
#   Project URL                    -> EXPO_PUBLIC_SUPABASE_URL
#   Publishable key (sb_publishable_...) -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# O prefixo EXPO_PUBLIC_ embute o valor no bundle do app. Isso e esperado para a
# chave publicavel: ela e publica por design e quem protege os dados e a RLS de
# `supabase/schema.sql`. NUNCA coloque aqui a chave `sb_secret_...`.
#
# Depois de mexer no .env.local, reinicie com `npx expo start --clear`.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cole-aqui
